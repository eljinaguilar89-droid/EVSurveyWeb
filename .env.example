# ─────────────────────────────────────────────────────────────────────────────
# EV Charging Station Solar — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in your Supabase project credentials below
#   3. NEVER commit .env.local to git (it's already in .gitignore)
#
# HOW TO GET THESE VALUES:
#   - Go to https://supabase.com → Your Project → Settings → API
#   - "Project URL"  → VITE_SUPABASE_URL
#   - "anon / public" key → VITE_SUPABASE_ANON_KEY
#
# FOR NETLIFY DEPLOYMENT:
#   - Go to Netlify → Site → Site configuration → Environment variables
#   - Add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY there
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
